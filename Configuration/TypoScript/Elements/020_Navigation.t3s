lib.navLevel1 = HMENU
lib.navLevel1 {

    1 = TMENU
    1 {
        NO = 1
        NO.allWrap = <div class="navigation_firstLevel-item -no">|</div>

        IFSUB < .NO
        IFSUB.allWrap = <div class="navigation_firstLevel-item -sub">|</div>
        IFSUB.afterWrap = <svg><use xlink:href="/typo3conf/ext/tmpl_fidaac/Resources/Public/Images/symbol-defs.svg#icon-caret-right"/></svg>


        CUR < .NO
        CUR.allWrap = <div class="navigation_firstLevel-item -cur">|</div>

        CURIFSUB < .CUR
        CURIFSUB.allWrap = <div class="navigation_firstLevel-item -curIfSub">|</div>
        CURIFSUB.afterWrap = <svg><use xlink:href="/typo3conf/ext/tmpl_fidaac/Resources/Public/Images/symbol-defs.svg#icon-caret-down"/></svg>


        ACT < .NO
        ACT.allWrap = <div class="navigation_firstLevel-item -act">|</div>
        ACT.ATagParams = class="strong"

        ACTIFSUB < .ACT
        ACTIFSUB.allWrap = <div class="navigation_firstLevel-item -actSub">|</div>
        ACTIFSUB.afterWrap = <svg><use xlink:href="/typo3conf/ext/tmpl_fidaac/Resources/Public/Images/symbol-defs.svg#icon-caret-down"/></svg>
    }
}

